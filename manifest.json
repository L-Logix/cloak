{
  "manifest_version": 3,
  "name": "Cloak: AI Privacy Layer",
  "version": "1.1",
  "minimum_chrome_version": "111",
  "description": "Masks personal identifying information locally before prompts hit AI servers.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://*.chatgpt.com/*",
    "*://gemini.google.com/*",
    "*://claude.ai/*",
    "*://*.claude.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cloak"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*"
      ],
      "js": ["intercept.bundle.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}