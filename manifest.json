{
  "manifest_version": 3,
  "name": "Cloak: AI Privacy Layer",
  "version": "1.2",
  "minimum_chrome_version": "111",
  "description": "Masks personal identifying information locally before prompts hit AI servers.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://*.chatgpt.com/*",
    "*://gemini.google.com/*",
    "*://claude.ai/*",
    "*://*.claude.ai/*"
  ],
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png",
    "256": "icons/logo-256.png",
    "512": "icons/logo-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cloak",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png",
      "128": "icons/logo-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*"
      ],
      "js": ["intercept.bundle.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}