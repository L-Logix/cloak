{
  "name": "cloak-extension",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first browser extension for masking sensitive prompt details",
  "scripts": {
    "build:interceptor": "esbuild intercept.js --bundle --minify --platform=browser --format=iife --target=chrome111 --outfile=intercept.bundle.js",
    "pretest": "npm run build:interceptor",
    "test": "node --test tests/intercept.test.js"
  },
  "dependencies": {
    "addressit": "^1.8.2",
    "compromise": "^14.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}