{
  "name": "cloak-extension",
  "private": true,
  "version": "1.2.0",
  "license": "GPL-3.0-only",
  "description": "Local-first, private browser extension for masking sensitive AI prompt details in chats",
  "scripts": {
    "build:interceptor": "esbuild intercept.js --bundle --minify --legal-comments=eof --platform=browser --format=iife --target=chrome111 --outfile=intercept.bundle.js",
    "pretest": "npm run build:interceptor",
    "test": "node --test \"tests/*.test.js\"",
    "docs:serve": "node docs/serve.cjs",
    "docs:verify": "node docs/verify.cjs",
    "docs:package": "node docs/package-download.cjs",
    "docs:benchmark": "node docs/benchmark.cjs"
  },
  "dependencies": {
    "addressit": "^1.8.2",
    "compromise": "^14.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}